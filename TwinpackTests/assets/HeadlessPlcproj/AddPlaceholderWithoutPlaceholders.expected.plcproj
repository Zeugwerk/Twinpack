<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <FileVersion>1.0.0.0</FileVersion>
    <SchemaVersion>2.0</SchemaVersion>
    <Name>Plc1</Name>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="POUs\MAIN.TcPOU">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <LibraryReference Include="Tc2_System,3.4.26.0,Beckhoff Automation GmbH">
      <Namespace>Tc2_System</Namespace>
    </LibraryReference>
  </ItemGroup>
  <ItemGroup>
    <PlaceholderReference Include="TcUnit">
      <DefaultResolution>TcUnit, * (www.tcunit.org)</DefaultResolution>
      <Namespace>TcUnit</Namespace>
      <Parameters>
        <Parameter ListName="GVL_PARAM_TCUNIT" xmlns="">
          <Key>MAXNUMBEROFTESTSUITES</Key>
          <Value>500</Value>
        </Parameter>
      </Parameters>
    </PlaceholderReference>
  </ItemGroup>
  <ItemGroup>
    <PlaceholderResolution Include="TcUnit">
      <Resolution>TcUnit, 1.3.1.0 (www.tcunit.org)</Resolution>
    </PlaceholderResolution>
  </ItemGroup>
  <ProjectExtensions>
    <PlcProjectOptions />
  </ProjectExtensions>
</Project>
